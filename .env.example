# ── Copy this file to .env and fill in your values. ──────────────────────────
# Never commit .env to version control.
# See supabase/SETUP.md for where to find each Supabase value.

# ── Backend (FastAPI) — keep ALL of these server-side only ───────────────────
APP_ENV=development

# Supabase project URL  (e.g. https://abcxyz.supabase.co)
SUPABASE_URL=

# Supabase service-role / secret key — NEVER expose this to the browser or
# commit it to version control.  Find it under Settings → API → service_role.
SUPABASE_SECRET_KEY=

# Optional: Supabase JWT Secret for local cryptographic verification (Settings → API → JWT Secret)
SUPABASE_JWT_SECRET=

# Gemini API key — server-side only; never put in any VITE_ variable.
GEMINI_API_KEY=

# Comma-separated allowed CORS origins for the FastAPI server
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Repository backend:
#   supabase  — production / real persistent storage (REQUIRED when deploying)
#   memory    — intentional in-memory demo mode (no Supabase credentials needed,
#               data lost on restart, safe for local/test use only)
# Default in config.py is "auto" which falls back to "memory" if Supabase
# credentials are absent. Set this explicitly to "supabase" for production.
REPOSITORY_BACKEND=supabase

# ── Frontend (Vite) — only VITE_ prefixed vars reach the browser bundle ──────
# Supabase project URL (same value as SUPABASE_URL above; safe for frontend)
VITE_SUPABASE_URL=

# Supabase anon / publishable key — safe for the browser.
# Find it under Settings → API → anon public.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Backend API base URL used by the React app (local dev default shown)
VITE_API_BASE_URL=http://localhost:8000
